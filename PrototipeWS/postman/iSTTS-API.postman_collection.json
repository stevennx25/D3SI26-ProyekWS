{
  "info": {
    "name": "iSTTS API - D3SI26 ProyekFPW",
    "description": "Koleksi Postman untuk seluruh endpoint backend iSTTS: Auth (admin), Mahasiswa, Alumni, dan Pendaftaran (dengan upload ijazah).\n\nCara pakai:\n1. Import file ini ke Postman (Import > File)\n2. Jalankan request \"Login Admin\" di folder Auth dulu\n3. Token hasil login otomatis tersimpan ke variable {{token}} lewat script di tab 'Tests' request tersebut\n4. Semua request yang butuh login akan otomatis pakai {{token}} di header Authorization",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "mahasiswaId", "value": "" },
    { "key": "alumniId", "value": "" },
    { "key": "pendaftaranId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('token', data.data.token);",
                  "    console.log('Token tersimpan:', data.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@istts.ac.id\",\n  \"password\": \"admin12345\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Register Admin Baru (khusus superadmin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Admin Kedua\",\n  \"email\": \"admin2@istts.ac.id\",\n  \"password\": \"password123\",\n  \"role\": \"admin\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Get Profil Admin (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Mahasiswa",
      "item": [
        {
          "name": "Get All Mahasiswa (public, dgn filter & paginasi)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/mahasiswa?page=1&limit=10&search=&fakultas=&status=",
              "host": ["{{baseUrl}}"],
              "path": ["mahasiswa"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "" },
                { "key": "fakultas", "value": "" },
                { "key": "status", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get Mahasiswa by ID (public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/mahasiswa/{{mahasiswaId}}"
          }
        },
        {
          "name": "Create Mahasiswa (admin only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('mahasiswaId', data.data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nrp\": \"225011799\",\n  \"nama\": \"Contoh Mahasiswa\",\n  \"email\": \"contoh@student.istts.ac.id\",\n  \"noHp\": \"081234567890\",\n  \"prodi\": \"D3 Manajemen Informatika\",\n  \"fakultas\": \"teknik\",\n  \"angkatan\": 2026,\n  \"semester\": 1,\n  \"status\": \"aktif\"\n}"
            },
            "url": "{{baseUrl}}/mahasiswa"
          }
        },
        {
          "name": "Update Mahasiswa (admin only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"semester\": 2,\n  \"status\": \"aktif\"\n}"
            },
            "url": "{{baseUrl}}/mahasiswa/{{mahasiswaId}}"
          }
        },
        {
          "name": "Delete Mahasiswa (admin only)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/mahasiswa/{{mahasiswaId}}"
          }
        }
      ]
    },
    {
      "name": "Alumni",
      "item": [
        {
          "name": "Get All Alumni (public, dgn filter & paginasi)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/alumni?page=1&limit=10&search=&fakultas=",
              "host": ["{{baseUrl}}"],
              "path": ["alumni"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "" },
                { "key": "fakultas", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get Alumni by ID (public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/alumni/{{alumniId}}"
          }
        },
        {
          "name": "Create Alumni (admin only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('alumniId', data.data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nrp\": \"215011699\",\n  \"nama\": \"Contoh Alumni\",\n  \"email\": \"alumni@gmail.com\",\n  \"noHp\": \"081234567891\",\n  \"prodi\": \"S1 Teknik Informatika\",\n  \"fakultas\": \"teknik\",\n  \"angkatan\": 2018,\n  \"tahunLulus\": 2022,\n  \"pekerjaan\": \"Backend Developer\",\n  \"perusahaan\": \"Tokopedia\",\n  \"testimoni\": \"Pengalaman kuliah di iSTTS sangat berkesan.\"\n}"
            },
            "url": "{{baseUrl}}/alumni"
          }
        },
        {
          "name": "Update Alumni (admin only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pekerjaan\": \"Senior Backend Developer\"\n}"
            },
            "url": "{{baseUrl}}/alumni/{{alumniId}}"
          }
        },
        {
          "name": "Delete Alumni (admin only)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/alumni/{{alumniId}}"
          }
        }
      ]
    },
    {
      "name": "Pendaftaran",
      "item": [
        {
          "name": "Submit Pendaftaran (public, upload ijazah)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('pendaftaranId', data.data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "namaLengkap", "value": "Budi Santoso", "type": "text" },
                { "key": "email", "value": "budi@gmail.com", "type": "text" },
                { "key": "noHp", "value": "081234567890", "type": "text" },
                { "key": "prodiPilihan", "value": "D3 Manajemen Informatika", "type": "text" },
                { "key": "pesan", "value": "Saya tertarik mendaftar", "type": "text" },
                { "key": "fileIjazah", "type": "file", "src": "" }
              ]
            },
            "url": "{{baseUrl}}/pendaftaran"
          }
        },
        {
          "name": "Get All Pendaftaran (admin only)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/pendaftaran?page=1&limit=10&status=",
              "host": ["{{baseUrl}}"],
              "path": ["pendaftaran"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get Pendaftaran by ID (admin only)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/pendaftaran/{{pendaftaranId}}"
          }
        },
        {
          "name": "Update Status Pendaftaran (admin only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"diverifikasi\"\n}"
            },
            "url": "{{baseUrl}}/pendaftaran/{{pendaftaranId}}/status"
          }
        },
        {
          "name": "Delete Pendaftaran (admin only)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/pendaftaran/{{pendaftaranId}}"
          }
        }
      ]
    }
  ]
}
