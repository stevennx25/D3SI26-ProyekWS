# Salin file ini jadi .env lalu isi nilainya. JANGAN commit file .env ke git!

# Port server backend
PORT=5000

# MongoDB connection string
# Lokal:        mongodb://127.0.0.1:27017/istts
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/istts
MONGO_URI=mongodb://127.0.0.1:27017/istts

# Secret key untuk JWT (ganti dengan string acak yang panjang & rahasia)
JWT_SECRET=ganti_dengan_secret_key_yang_acak_dan_panjang
JWT_EXPIRES_IN=1d

# Origin frontend yang diizinkan akses API (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Admin default yang dibuat oleh seeder (npm run seed)
ADMIN_DEFAULT_EMAIL=admin@istts.ac.id
ADMIN_DEFAULT_PASSWORD=admin12345
